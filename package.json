{
	"name": "pi-smart-terminal",
	"version": "0.1.1",
	"description": "Persistent PTY terminal sessions for pi: overrides the built-in bash tool with a stateful shell, adds terminal_* tools, a live session overlay (/term) and footer status. Powered by smart-terminal-mcp.",
	"keywords": [
		"pi-package",
		"pi",
		"pi.dev",
		"pi-extension",
		"terminal",
		"pty",
		"bash",
		"shell",
		"smart-terminal"
	],
	"license": "MIT",
	"type": "module",
	"main": "src/index.ts",
	"files": [
		"src",
		"docs",
		"README.md",
		"LICENSE"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/pungggi/pi-smart-terminal.git"
	},
	"homepage": "https://github.com/pungggi/pi-smart-terminal#readme",
	"bugs": {
		"url": "https://github.com/pungggi/pi-smart-terminal/issues"
	},
	"engines": {
		"node": ">=20.0.0"
	},
	"dependencies": {
		"smart-terminal-mcp": "^1.2.37"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": ">=0.84.1",
		"@earendil-works/pi-tui": ">=0.84.1"
	},
	"devDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": ">=0.84.1",
		"@earendil-works/pi-tui": ">=0.84.1",
		"@types/node": "^22.0.0",
		"typebox": "*",
		"typescript": "^5.6.0",
		"vitest": "^3.0.0"
	},
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"scripts": {
		"prepublishOnly": "node -e \"if(!process.env.CI)throw new Error('publish via release.yml CI: push a v* tag. Manual npm publish is blocked.')\"",
		"test": "vitest run",
		"test:watch": "vitest watch",
		"typecheck": "tsc --noEmit",
		"check": "npm run typecheck && npm run test"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	}
}
